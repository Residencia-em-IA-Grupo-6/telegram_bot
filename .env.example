# Configurações do Bot do Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Integração com o Back-end FactChkBR (FastAPI)
BACKEND_API_URL=http://localhost:8000/api/analyze
BACKEND_HEALTH_URL=http://localhost:8000/api/health
BACKEND_TIMEOUT=60.0

# Modo de Operação:
# - USE_MOCK=false -> conecta à API real do FactChkBR
# - USE_MOCK=true  -> usa simulador local sem depender do back-end
USE_MOCK=false

# Modo de Saída:
# - raw  -> texto cru e direto conforme especificação do projeto
# - rich -> formatação HTML enriquecida gerada pelo back-end
OUTPUT_MODE=raw
